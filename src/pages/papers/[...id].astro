---
import { getCollection, render } from 'astro:content';
import PaperLayout from '../../layouts/PaperLayout.astro';

export async function getStaticPaths() {
  // Drafts are previewable in dev but never built for production.
  const papers = (await getCollection('papers')).filter((e) => !import.meta.env.PROD || !e.data.draft);
  return papers.map(paper => ({
    params: { id: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
---
<PaperLayout
  title={paper.data.title}
  description={paper.data.description}
  pubDate={paper.data.pubDate}
  authors={paper.data.authors}
  pdfUrl={paper.data.pdfUrl}
  venue={paper.data.venue}
  doi={paper.data.doi}
  publications={paper.data.publications}
  tags={paper.data.tags}
  theme={paper.data.theme}
  lang={paper.data.lang}
>
  <Content />
</PaperLayout>
